rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validMission(mission, id) {
      return mission.keys().hasOnly(['id', 'completed'])
        && mission.id == id && mission.completed is bool;
    }
    function validProgress(data) {
      return data.keys().hasOnly(['points', 'missions'])
        && data.missions is list && data.missions.size() == 3
        && validMission(data.missions[0], 1)
        && validMission(data.missions[1], 2)
        && validMission(data.missions[2], 3)
        && (!data.missions[2].completed || data.missions[1].completed)
        && data.points == (data.missions[0].completed ? 40 : 0)
          + (data.missions[1].completed ? 40 : 0)
          + (data.missions[2].completed ? 40 : 0);
    }
    match /parcial2Progress/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validProgress(request.resource.data);
      allow update: if owner(uid) && validProgress(request.resource.data)
        && (!resource.data.missions[0].completed || request.resource.data.missions[0].completed)
        && (!resource.data.missions[1].completed || request.resource.data.missions[1].completed)
        && (!resource.data.missions[2].completed || request.resource.data.missions[2].completed);
    }
    match /parcial2Ranking/{uid} {
      allow read: if request.auth != null;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'points'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.points == getAfter(/databases/$(database)/documents/parcial2Progress/$(uid)).data.points;
    }
  }
}
